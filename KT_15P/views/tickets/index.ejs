<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Event Tickets - Danh sach</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/basic.css" rel="stylesheet" />
</head>

<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">Quản lý vé</h1>
            <a href="/tickets/add" class="">Thêm vé</a>
        </div>

        <% if (message) { %>
            <div class="alert alert-<%= messageType %>">
                <%= message %>
            </div>
            <% } %>

                <form class="" method="GET" action="/tickets">
                    <div class="col-md-5">
                        <input class="form-control" type="text" name="q" placeholder="Tìm kiếm" value="<%= query %>" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="status">
            <option value="">Trạng thái</option>
            <option value="Upcoming" <%= status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
            <option value="Sold" <%= status === 'Sold' ? 'selected' : '' %>>Sold</option>
            <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button class="btn" type="submit">Tìm</button>
                        <a class="btn" href="/tickets">Reset</a>
                    </div>
                </form>

                <div class="table-responsive ">
                    <table class="table">
                        <thead class="table">
                            <tr>

                                <th>ID</th>
                                <th>Tên sự kiện</th>
                                <th>Tên nhà tổ chức</th>
                                <th>Loại</th>
                                <th>Số lượng</th>
                                <th>Giá vé gốc</th>
                                <th>Tổng tiền</th>
                                <th>Giá cuối</th>
                                <th>Trạng thái vé</th>
                                <th>TKhuyến mãi</th>

                                <th>Hành động</th>

                                <th>Ngày diễn ra</th>
                                <th>URL ảnh</th>
                                <th>Ngày tạo ảnh</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!tickets.length) { %>
                                <tr>
                                    <td colspan="11" class="text-center text-muted">Không có vé để hiển thị</td>
                                </tr>
                                <% } %>

                                    <% tickets.forEach(function(ticket) { %>
                                        <tr>
                                            <td><small><%= ticket.ticketId %></small></td>
                                            <td>
                                                <%= ticket.eventName %>
                                            </td>
                                            <td>
                                                <%= ticket.holderName %>
                                            </td>
                                            <td>
                                                <%= ticket.category %>
                                            </td>
                                            <td>
                                                <%= ticket.quantity %>
                                            </td>
                                            <td>
                                                <%= Number(ticket.pricePerTicket).toLocaleString('vi-VN') %>
                                            </td>
                                            <td>
                                                <%= Number(ticket.totalAmount).toLocaleString('vi-VN') %>
                                            </td>
                                            <td>
                                                <%= Number(ticket.finalAmount).toLocaleString('vi-VN') %>
                                            </td>
                                            <td>
                                                <span class="badge text-bg-info"><%= ticket.status %></span>
                                            </td>
                                            <td>
                                                <% const discounted = Number(ticket.finalAmount) < Number(ticket.totalAmount); %>
                                                    <% if (discounted) { %>
                                                        <span class="badge ">Giảm giá</span>
                                                        <% } else { %>
                                                            <span class="badge ">Không giảm giá</span>
                                                            <% } %>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <a class="btn btn-sm " href="/tickets/<%= ticket.ticketId %>">Chi tiết</a>
                                                    <a class="btn btn-sm " href="/tickets/<%= ticket.ticketId %>/edit">Sửa</a>
                                                    <form action="/tickets/<%= ticket.ticketId %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa vé này?')">
                                                        <button class="btn btn-sm">Xóa</button>
                                                    </form>
                                                </div>
                                            </td>
                                            <td>

                                            </td>
                                            <td>

                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">

                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                        </tbody>
                    </table>
                </div>
    </div>
</body>

</html>