<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Quản lý Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-4">
    <h2 class="mb-4">Danh Sách Sản Phẩm</h2>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
            <%= success %>
        </div>
        <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <% } %>

                    <div class="d-flex justify-content-between mb-3">
                        <a href="/add" class="btn btn-primary">Thêm Sản Phẩm Mới</a>
                        <form class="d-flex" action="/" method="GET">
                            <input class="form-control me-2" type="search" name="search" placeholder="Tên sản phẩm..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                            <button class="btn btn-outline-success" type="submit">Tìm</button>
                        </form>
                    </div>

                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Hình ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Giá (VNĐ)</th>
                                <th>Tồn kho</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(products.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center">Chưa có dữ liệu</td>
                                </tr>
                                <% } else { %>
                                    <% products.forEach(p => { %>
                                        <tr>
                                            <td><img src="<%= p.url_image %>" width="80" class="img-thumbnail" alt="<%= p.name %>"></td>
                                            <td>
                                                <%= p.name %>
                                            </td>
                                            <td>
                                                <%= p.price.toLocaleString() %>
                                            </td>
                                            <td>
                                                <%= p.unit_in_stock %>
                                            </td>
                                            <td>
                                                <a href="/detail/<%= p.id %>" class="btn btn-info btn-sm">Xem</a>
                                                <a href="/edit/<%= p.id %>" class="btn btn-warning btn-sm">Sửa</a>
                                                <form action="/delete/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa?');">
                                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } %>
                        </tbody>
                    </table>
</body>

</html>